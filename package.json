{
  "name": "saving",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.server.json && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "set-pattern": "node --import ./scripts/resolve-ts.ts scripts/set-pattern.ts",
    "setup-sheet": "node --env-file-if-exists=.env.local --import ./scripts/resolve-ts.ts scripts/setup-sheet.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
