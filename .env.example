# Copy to .env.local for local dev; set the same keys in Vercel → Project → Settings → Environment Variables.

# Output of `pnpm hash-pin`. The PIN itself is never stored anywhere.
PIN_HASH=

# Random string, at least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=

# From the service account JSON key: "client_email" and "private_key" (keep the \n, keep the quotes).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# The part between /d/ and /edit in the spreadsheet URL.
SPREADSHEET_ID=
